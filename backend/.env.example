# Backend Environment Configuration Template
# Copy this to .env and update the values

# Flask Configuration
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
FLASK_ENV=development
FLASK_DEBUG=True

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-jwt-secret-at-least-32-chars
ACCESS_TOKEN_TTL=90000         # 25 hours in seconds
REFRESH_TOKEN_TTL=604800       # 7 days in seconds

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=adaptive_ids
POSTGRES_USER=adaptive_ids
POSTGRES_PASSWORD=adaptive_ids_password

# PostgreSQL Database Connection String
PG_DSN=postgresql://adaptive_ids:adaptive_ids_password@localhost:55432/adaptive_ids

# Model Configuration
ADAPTIVE_IDS_MODEL_ROOT=./model
ADAPTIVE_IDS_MODEL_RUN=

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
PACKETS_TOPIC=raw.packets
FEATURES_TOPIC=flows.features
PRED_TOPIC=predictions
ALERTS_TOPIC=alerts

# Packet Capture Configuration (Development)
# Find your interface number/name using: tshark -D
PCAP_IFACE=1                       # Network interface: 1=Ethernet, 6=Wi-Fi (use number or name)
PCAP_FILTER=                       # Optional: Leave empty to capture all traffic

# Feature Extraction Configuration
FEATURE_EXTRACTOR_GROUP=feature-extractor
FLOW_ACTIVE_TIMEOUT=60.0          # Active timeout in seconds (max flow duration)
FLOW_IDLE_TIMEOUT=15.0            # Idle timeout in seconds (max time between packets)
FEATURE_VERSION=v1.0-cic41        # Feature version identifier
STATE_DIR=stream/state            # Directory for scaler persistence

# ============================================================================
# ALERTING INTEGRATIONS
# ============================================================================

# Email Notifications
EMAIL_ENABLED=false               # Set to true to enable email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here  # Use Gmail App Password, not regular password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@example.com
EMAIL_CC=

# Syslog Integration (Optional)
SYSLOG_ENABLED=false
SYSLOG_HOST=localhost
SYSLOG_PORT=514
SYSLOG_PROTOCOL=UDP

# Splunk Integration (Optional)
SPLUNK_ENABLED=false
SPLUNK_HOST=localhost
SPLUNK_PORT=8088
SPLUNK_TOKEN=your-splunk-hec-token

# QRadar Integration (Optional)
QRADAR_ENABLED=false
QRADAR_HOST=localhost
QRADAR_PORT=514

# Elastic SIEM Integration (Optional)
ELASTIC_ENABLED=false
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
ELASTIC_INDEX=adaptive-ids-alerts
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme

# Graylog Integration (Optional)
GRAYLOG_ENABLED=false
GRAYLOG_HOST=localhost
GRAYLOG_PORT=12201

# Legacy alert email (deprecated - use EMAIL_TO instead)
ALERT_EMAIL_TO=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_STORAGE_URL=memory://

# Compression
COMPRESS_ENABLED=True
COMPRESS_LEVEL=6
COMPRESS_MIN_SIZE=500

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=detailed

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Secrets Management
SECRETS_MASTER_PASSWORD=ChangeThisToASecurePassword!
SECRETS_FILE=backend/security/secrets.enc
MASTER_KEY_FILE=backend/security/master.key

# API Keys - Generate using: python -c "import secrets; print('aids_' + secrets.token_urlsafe(32))"
MODEL_SERVICE_API_KEY=aids_generate-a-new-key-here
ALERTING_SERVICE_API_KEY=aids_generate-a-new-key-here
FEATURE_EXTRACTOR_API_KEY=aids_generate-a-new-key-here

# Audit Logging
AUDIT_LOG_FILE=logs/audit.log

# mTLS (mutual TLS)
MTLS_ENABLED=false                # Set to true to enable mTLS
MTLS_CA_CERT=backend/security/certs/ca-cert.pem
MTLS_SERVER_CERT=backend/security/certs/backend-server-cert.pem
MTLS_SERVER_KEY=backend/security/certs/backend-server-key.pem
MTLS_CLIENT_CERT=backend/security/certs/alerting-service-client-cert.pem
MTLS_CLIENT_KEY=backend/security/certs/alerting-service-client-key.pem

# ============================================================================
# OPENTELEMETRY & OBSERVABILITY
# ============================================================================

# OpenTelemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=adaptive-ids-backend

# Prometheus Metrics
PROMETHEUS_PORT=9090

# Jaeger Tracing
JAEGER_UI_PORT=16686
