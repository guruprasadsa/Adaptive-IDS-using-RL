# Flask configuration
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-change-this-in-production

# JWT token expiration times (in seconds)
ACCESS_TOKEN_TTL=90000         # 25 hours
REFRESH_TOKEN_TTL=604800     # 7 days

# PostgreSQL database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=adaptive_ids
POSTGRES_USER=adaptive_ids
POSTGRES_PASSWORD=your_password_here

# Model configuration
ADAPTIVE_IDS_MODEL_ROOT=./backend/model
ADAPTIVE_IDS_MODEL_RUN=

# Admin user creation (used by create_admin.py script)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

# CORS Configuration (frontend URL)
CORS_ORIGINS=http://localhost:5173

# API Configuration
COMPRESS_ENABLED=True
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100 per hour
