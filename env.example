# Adaptive IDS v2.0 Environment Configuration
# Copy this file to .env and update with your secure values

# Database Configuration
POSTGRES_USER=adaptive_ids
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=adaptive_ids

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_SECRET_KEY=your_api_secret_key_here
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Kafka Configuration
KAFKA_BROKERS=kafka:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Model Service Configuration
MODEL_DEVICE=cuda
MODEL_BATCH_SIZE=256
MODEL_MAX_BATCH_WAIT_MS=50
MODEL_CONFIDENCE_THRESHOLD=0.5

# Monitoring Configuration
PROMETHEUS_RETENTION_DAYS=30
GRAFANA_INSTALL_PLUGINS=grafana-piechart-panel

# Security Configuration
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
ENABLE_CORS=true
ENABLE_HTTPS=false

# Development Configuration
FLASK_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Email Alerting Configuration
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
EMAIL_FROM=ids-alerts@example.com
EMAIL_TO=security-team@example.com,admin@example.com
EMAIL_CC=
EMAIL_MIN_SEVERITY=HIGH
EMAIL_MAX_PER_MINUTE=10
EMAIL_MAX_PER_HOUR=500
EMAIL_MAX_PER_DAY=10000

