# Frontend Environment Configuration
# Copy this file to .env.local and update values as needed

# API Backend URL
# For development: use localhost with the backend port
# For production: use your backend server URL
VITE_API_BASE_URL=http://localhost:5001

# API Version
VITE_API_VERSION=v1

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# Enable API Request/Response Logging (useful for debugging)
VITE_ENABLE_API_LOGGING=false

# Enable Real-time Updates via SSE
VITE_ENABLE_REALTIME=true

# Enable Client-side Caching
VITE_ENABLE_CACHING=true

# Development Mode
VITE_DEV_MODE=true

# ============================================================================
# NOTES
# ============================================================================
# - For development, use http://localhost:5001 as VITE_API_BASE_URL
# - For production builds, update VITE_API_BASE_URL to your deployed backend
# - After changing these values, restart the Vite dev server
# - Variables must start with VITE_ to be accessible in the client code
